# Copy to .env and fill in. Every value here has a default; the ones left empty are optional.

# ---------------------------------------------------------------- what the bot does
# signals    = notify you about opportunities (no orders)
# autonomous = trade on its own, PAPER account only
BOT_MODE=signals
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Candle timeframes the bot evaluates on every close. Any of:
# 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d 3d 1w
TIMEFRAMES=15m,1h
# Binance public market data (no key needed)
MARKET_DATA_URL=https://data-api.binance.vision

# ---------------------------------------------------------------- LLM provider (replaceable)
# Provider for every role unless a role overrides it:
#   anthropic | openai | deepseek | groq | openrouter | xai | gemini | mistral | together | ollama
#   openai-compatible (any other OpenAI-style API; set LLM_BASE_URL) | mock (offline, scripted)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Key for the provider. If empty, the provider's own variable is read instead:
# ANTHROPIC_API_KEY, OPENAI_API_KEY, DEEPSEEK_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY,
# XAI_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY, TOGETHER_API_KEY
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=16000
# Reasoning effort: Anthropic output_config.effort (low|medium|high|xhigh|max) or
# OpenAI reasoning_effort. Empty = the provider's default.
LLM_EFFORT=

# Per-role overrides. Each role falls back to the LLM_* values above.
# Effort only matters for models that support it; with Anthropic, "low" suits the
# router, filter and watchdog, whose work is short routing and judgement calls.
# The Router only routes and talks, so a lighter, faster model works well there.
ROUTER_PROVIDER=
ROUTER_MODEL=
ROUTER_EFFORT=
# Workers do the analysis and trading decisions: use your strongest model.
WORKER_PROVIDER=
WORKER_MODEL=
WORKER_EFFORT=
# The semantic filter runs one short batched call per burst of candidates.
FILTER_PROVIDER=
FILTER_MODEL=
FILTER_EFFORT=
WATCHDOG_PROVIDER=
WATCHDOG_MODEL=
WATCHDOG_EFFORT=
# Anthropic only: server-side fallback when a request is declined. auto = on for models that support it.
ANTHROPIC_FALLBACKS=auto

# Examples:
#   All DeepSeek:            LLM_PROVIDER=deepseek  LLM_MODEL=deepseek-chat  DEEPSEEK_API_KEY=...
#   OpenAI workers:          WORKER_PROVIDER=openai  WORKER_MODEL=<model>  OPENAI_API_KEY=...
#   Local Ollama router:     ROUTER_PROVIDER=ollama  ROUTER_MODEL=qwen2.5:14b
#   Any OpenAI-style server: LLM_PROVIDER=openai-compatible  LLM_BASE_URL=http://host:8000/v1  LLM_MODEL=...
#   Try it with no key:      LLM_PROVIDER=mock

# ---------------------------------------------------------------- agent tuning
MAX_WORKERS=4
MAX_TOOL_STEPS=24
ROUTER_COMPACT_TOKENS=120000
WORKER_COMPACT_TOKENS=150000
# Setups below this detector score are dropped by code before any model sees them.
MIN_SETUP_SCORE=0.55
# Reward:risk used for detector targets
TARGET_R=2
# Speculative pre-analysis of near-setups (acting ahead)
SPECULATIVE=on
NEAR_SETUP_ATR=0.35
MAX_SPECULATIVE=2

# ---------------------------------------------------------------- channels
# Where notifications go (any configured channel names)
NOTIFY_CHANNELS=console
# IM channels (console, telegram, discord, http) cap messages at this many words
IM_WORD_LIMIT=100
CONSOLE_CHANNEL=on

# Telegram: create a bot with @BotFather. Only chats listed here are accepted;
# messages from other chats are ignored and their id is logged so you can add it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Group messages not addressed to the bot: explicit (ignore) | candidate (let the filter judge) | ignore
TELEGRAM_GROUP_MODE=explicit

DISCORD_WEBHOOK_URL=
# Generic JSON webhook (structured, full-detail messages)
WEBHOOK_URL=

# Status API + HTTP chat. 0 disables it. Binds to 127.0.0.1 unless HTTP_HOST is set.
HTTP_PORT=8787
HTTP_TOKEN=
HTTP_HOST=127.0.0.1

# ---------------------------------------------------------------- schedule and watchdog
# UTC time of the daily digest
DAILY_DIGEST_TIME=21:00
WATCHDOG_INTERVAL_SEC=300
WORKER_STALL_MIN=20

# ---------------------------------------------------------------- execution endpoint
# local = in-process. Or the URL of a daemon started with `npm run endpoint`
# on the machine that should hold the paper ledger, e.g. http://10.0.0.5:8788
EXECUTION_ENDPOINT=local
ENDPOINT_TOKEN=
ENDPOINT_PORT=8788

# ---------------------------------------------------------------- paper account and risk
PAPER_STARTING_CASH=10000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5
ALLOW_SHORTS=false
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=20
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=3
STOPOUT_COOLDOWN_MIN=60

# ---------------------------------------------------------------- storage and logs
DATA_DIR=./data
LOG_LEVEL=info
